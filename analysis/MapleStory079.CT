      <AssemblerScript>[ENABLE]
alloc(CoordCave, 1024)
registersymbol(CoordCave)

CoordCave:
  pushad
  mov esi, [00BDD490]
  test esi, esi
  jz CoordExit
  push edx
  push ecx
  push ebx
  mov eax, [00BDEB38]
  test eax, eax
  jz CoordNo
  mov edx, eax
  cmp dword [edx+0x0C], 0
  je CoordNo
  mov [CoordCave+0x388], esi
  mov eax, [esi+0xee8]
  mov [CoordCave+0x384], eax
  mov eax, [esi+0xeec]
  mov [CoordCave+0x394], eax
  mov dword [CoordCave+0x38C], 0
  mov ecx, [CoordCave+0x3CC]
  test ecx, ecx
  jnz HaveCnt
  mov ecx, [edx+0x0C]
  test ecx, ecx
  jz CoordNo
  mov [CoordCave+0x3CC], ecx
HaveCnt:
  mov ebx, [CoordCave+0x3A4]
  inc ebx
  cmp ebx, ecx
  jb SaveIdx
  xor ebx, ebx
SaveIdx:
  mov [CoordCave+0x3A4], ebx
  cmp ebx, [edx+0x0C]
  jae CoordNo
  lea ecx, [edx+0x18]
  push ebx
  call 00743100
  test eax, eax
  jz CoordNo
  mov eax, [eax+4]
  test eax, eax
  jz CoordNo
  movsx ecx, word [eax+0x14]
  mov [CoordCave+0x380], ecx
  movsx edx, word [eax+0x18]
  mov [CoordCave+0x390], edx
  sub ecx, 20
  mov [esi+0xee8], ecx
  mov [esi+0xeec], edx
  mov dword [CoordCave+0x38C], 1
  inc dword [CoordCave+0x3D4]
CoordNo:
  pop ebx
  pop ecx
  pop edx
CoordExit:
  popad
  mov esi, [00BDD490]
  jmp 00742393

CoordPost:
  pushad
  cmp dword [CoordCave+0x38C], 0
  je CoordSkip
  mov esi, [CoordCave+0x388]
  test esi, esi
  jz CoordSkip
  mov eax, [CoordCave+0x384]
  mov [esi+0xee8], eax
  mov eax, [CoordCave+0x394]
  mov [esi+0xeec], eax
CoordSkip:
  cmp byte [CoordCave+0x3B8], 1
  je AllDone
  mov byte [CoordCave+0x3B8], 1
  mov ebx, 10 // 此处修改
ExtraLoop:
  push eax
  push ecx
  push edx
  mov eax, [00BDEB38]
  test eax, eax
  jz ExtraSkip
  cmp dword [eax+0x0C], 0
  je ExtraSkip
  mov ecx, eax
  push [00BDD490]
  call 00742294
  add esp, 4
ExtraSkip:
  pop edx
  pop ecx
  pop eax
  dec ebx
  jnz ExtraLoop
  mov byte [CoordCave+0x3B8], 0
AllDone:
  popad
  or dword [ebp-4], -1
  lea ecx, [ebp-0x10]
  jmp 0074269E

0074238D:
  jmp CoordCave
  nop

00742697:
  jmp CoordPost
  nop
  nop

[DISABLE]
00742294:
  db B8 18 05 AC 00
0074238D:
  db 8B 35 90 D4 BD 00
00742697:
  db 83 4D FC FF 8D 4D F0
dealloc(CoordCave)
unregistersymbol(CoordCave)
