    <CheatEntry>
      <ID>387</ID>
      <Description>"自动汇编脚本"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
// ============================================================
// 去除地图切换黑屏 V3
//
// 收录所有路线:
//  ① 场切换跳过旧场销毁 (sub_9ECBB7 + sub_9ECC8E)
//  ② 阻止加载状态设置 (sub_5CAA80 + sub_5CBDF7)
//  ③ 跳过淡入动画 (sub_77F62C)
//  ④ 设置 CWvsContext 标志跳过淡入
//  ⑤ 缩短 D3D 设备等待循环
// ============================================================

// === ① 场切换跳过旧场销毁 ===

// sub_9ECBB7: vtable+40(oldField, 0)
// 8B 01 6A 00 FF 50 28 → NOP
MapleStory.exe+5ECC14:
  db 90 90 90 90 90 90 90

// sub_9ECC8E: vtable+40(oldField, 0)
// 8B 01 53 FF 50 28 → NOP
MapleStory.exe+5ECD38:
  db 90 90 90 90 90 90

// === ② 阻止加载状态设置 ===

// sub_9ECBB7: push 1; call sub_5CAA80
// 6A 01 E8 xx xx xx xx → NOP
MapleStory.exe+5ECBF6:
  db 90 90 90 90 90

// sub_9ECBB7: push 1; call sub_5CBDF7
MapleStory.exe+5ECBFC:
  db 90 90 90 90 90 90 90 90 90

// sub_9ECC8E: push 1; mov ecx,eax; call sub_5CAA80
MapleStory.exe+5ECCF7:
  db 90 90 90 90 90 90 90

// === ③ 跳过淡入动画 ===
// sub_77F62C 函数入口 → 直接返回
// 函数做了600ms的alpha渐变画黑色覆盖层
// 改为: retn
MapleStory.exe+37F62C:
  db C3

// === ④ 设置 CWvsContext 淡入跳过标志 ===
// 条件检查: if (CWvsContext and !*(CWvsContext + 0x2FE4))
// 把 [CWvsContext+0x2FE4] 设为非0 = 跳过淡入
// 或者直接 NOP 掉条件判断中的取反检查
MapleStory.exe+37F7F9:  // cmp dword ptr [CWvsContext+2FE4h], 0
  db 90 90 90 90 90 90  // NOP 掉条件分支

// === ⑤ 缩短 D3D 设备等待循环 ===
// sub_5CB33F 中的等待循环:
// push 64h (100ms); call dword_BE1594; inc edi; cmp edi,0Ah
// 改为: 把64h(100ms)改成0 = 不等待
MapleStory.exe+1CB54A:
  db 6A 00  // push 0 代替 push 64h (100ms)

[DISABLE]
// ① 还原
MapleStory.exe+5ECC14:
  db 8B 01 6A 00 FF 50 28
MapleStory.exe+5ECD38:
  db 8B 01 53 FF 50 28

// ② 还原
MapleStory.exe+5ECBF6:
  db 6A 01
MapleStory.exe+5ECBFC:
  db 8B 0D 38 D8 BD 00 6A 01
MapleStory.exe+5ECCF7:
  db 6A 01 8B C8

// ③ 还原
MapleStory.exe+37F62C:
  db 55            // push ebp (函数原入口)

// ④ 还原
MapleStory.exe+37F7F9:
  db 83 7D 08 00  // cmp dword ptr [ebp+8], 0

// ⑤ 还原
MapleStory.exe+1CB54A:
  db 6A 64        // push 64h (100ms)
</AssemblerScript>
    </CheatEntry>
