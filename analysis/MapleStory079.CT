          <AssemblerScript>[ENABLE]
// ============================================
// 禁用技能准备特效 (方案1)
// 原理: NOP 掉 ShowSkillPrepare 中的特效调用
// 效果: 角色不播放技能准备光效(如勇士蓄力等)
// 注意: 不影响技能实际效果,仅屏蔽视觉效果
// ============================================

93CB05:
  db 90 90 90 90 90    // call CAnimationDisplayer__Effect_SkillPrepare → NOP

[DISABLE]
93CB05:
  db E8 DD 08 B0 FF    // 还原 call
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>328</ID>
          <Description>"禁用人物自身技能特效"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
// ============================================
// 禁用人物自身技能特效 (人物相关)
// 包含:
//   1. CUser__CreateSkillEffect — 技能视觉特效(粒子/光效)
//   2. CUser::RegisterAfterimage — 武器刀光残影
// 原理: 跳过特效创建代码,不影响技能判定
// ============================================

// --- 1. 技能视觉特效 ---
93A028:
  db E9 AA 28 00 00 90    // jmp exit + nop

// --- 2. 武器刀光残影 ---
98661A:
  db 90 90 90 90 90       // NOP call

[DISABLE]
93A028:
  db 0F 85 A9 28 00 00    // 还原: jnz exit
98661A:
  db E8 E5 FB FA FF       // 还原: call RegisterAfterimage
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>334</ID>
          <Description>"怪物受击特效-跳过循环"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>// == test_skip_fx_loop.aa ==
// 禁用怪物受击视觉特效 - 方案2: 跳过特效队列遍历循环
// 在循环起点 0x6969F9 处, 将读链表头改为直接 jmp 到循环结束地址 0x696B47
//
// 循环结构:
//   6969F9: mov eax,[ebx+458h]   ; 读取特效链表头(原指令)
//   6969FF: cmp eax,edi           ; edi=0, 判空
//   696A01: jz loc_696B47        ; 空则退出循环
//   ... (循环体) ...
//   696A2D: js short loc_6969FF   ; 继续循环
//
// 计算: jmp offset = 0x696B47 - 0x6969F9 - 5 = 0x149

[ENABLE]
6969F9:
jmp 696B47
nop

[DISABLE]
6969F9:
db 8B 83 58 04 00 00

</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>380</ID>
          <Description>"怪物受击特效-清空表头"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>// == test_fx_queue_clear.aa ==
// 禁用怪物受击视觉特效 - 方案3: 清零特效链表头
// 在 0x6969F9 处, 将读链表头改为 xor eax,eax (清零 eax)
// 后续 cmp eax,edi 比较 eax=0 与 edi=0, 相等则 jz 跳过循环
//
// 注意: 严格来说只清零了 eax 而非 [ebx+0x458] 自身,
// 但由于 edi=0, cmp eax,edi 直接判等跳过循环, 达到相同效果.
// 原始指令 8B 83 58 04 00 00 (6字节) 空间限制无法同时清零链表头和 eax.

[ENABLE]
6969F9:
xor eax,eax
nop
nop
nop
nop

[DISABLE]
6969F9:
db 8B 83 58 04 00 00

</AssemblerScript>
        </CheatEntry>
      </CheatEntries>
