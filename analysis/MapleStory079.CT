    <CheatEntry>
      <ID>281</ID>
      <Description>"移除怪物出现的无敌状态"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat

 // MapleStory.exe+564417 - 0F85 0F140000         - jne MapleStory.exe+56582C
MapleStory.exe+564417:
  db 90 90 90 90 90 90
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
MapleStory.exe+564417:
  db 0F 85 0F 14 00 00
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>279</ID>
      <Description>"怪物死后直接删除-会变身的怪物请勿开启"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
// MapleStory.exe - 怪物快速生成与消失
// 跳过怪物死亡动画 + 清除死亡状态，使怪物瞬生瞬灭

// Hook 1: 跳过死亡动画 - 强制走直接移除路径
// 地址: CMobPool::OnMobLeaveField 内 0x6A6E27
// 原始: 75 40  (jnz loc_6A6E69 → 走死亡动画路径)
// 补丁: NOP x2 → fall through 直接移除，跳过死亡动画和延迟队列
MapleStory.exe+2A6E27:
  db 90 90

// Hook 2: 清除死亡状态标志
// 地址: 0x6A6E69
// 原始: 89 B8 04 04 00 00  (mov [eax+404h], edi → 写入死亡类型)
// 补丁: NOP x6 → mob+0x404 保持为0，渲染/动画系统不视为死亡状态
MapleStory.exe+2A6E69:
  db 90 90 90 90 90 90

[DISABLE]
// 恢复 Hook 1: 恢复死亡动画跳转
MapleStory.exe+2A6E27:
  db 75 40

// 恢复 Hook 2: 恢复死亡状态写入
MapleStory.exe+2A6E69:
  db 89 B8 04 04 00 00
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>376</ID>
      <Description>"怪物速死-跳过怪物死亡"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]

// Patch 1: 死亡类型0-1 分支A - 计时器值 21→-1
MapleStory.exe+291FB6:
  db 6A FF

// Patch 2: 死亡类型0-1 分支B - 随机计时器值改为-1
MapleStory.exe+291FCB:
  db 83 C9 FF

[DISABLE]

MapleStory.exe+291FB6:
  db 6A 15

MapleStory.exe+291FCB:
  db 83 C1 09
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>280</ID>
      <Description>"物品指定位置掉落(Drop to Custom Position)"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
alloc(DropPosCave,2048)
alloc(DropPosX,4)
alloc(DropPosY,4)
registersymbol(DropPosX)
registersymbol(DropPosY)

DropPosCave:
  mov eax,[DropPosX]
  mov [ebp-88],eax
  mov eax,[DropPosY]
  mov [ebp-84],eax
  mov eax,[ebp-14]
  lea ecx,[ebp-88]
  push ecx
  jmp 0050e878

0050e86e:
  jmp DropPosCave
  db 90 90 90 90 90

[DISABLE]
0050e86e:
  db 8B 45 EC
  db 8D 8D 78 FF FF FF
  db 51

unregistersymbol(DropPosX)
unregistersymbol(DropPosY)
dealloc(DropPosCave)
dealloc(DropPosX)
dealloc(DropPosY)
</AssemblerScript>
