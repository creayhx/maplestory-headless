    <CheatEntry>
      <ID>381</ID>
      <Description>"怪物跟随 - 玩家自动瞬移到怪物位置"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
// ====================================================
// 怪物跟随 - 玩家自动瞬移到最近怪物位置
// Hook: MapleStory.exe+9552F0 (坐标同步函数入口)
// ====================================================
alloc(followCode, 1024, MapleStory.exe+9552F0)
alloc(followTimer, 4, MapleStory.exe+9552F0)
registersymbol(followTimer)

label(followExit)
label(mobLoop)
label(nextSlot)
label(done)

// 初始化计数器
followTimer:
  dd 0

// Hook 点: 替换函数前6字节
MapleStory.exe+9552F0:
  jmp followCode
  nop

// ---- 代码洞穴 ----
followCode:
  // 保存寄存器
  push eax
  push ecx
  push edx
  push ebx
  push esi
  push edi

  // 帧计数器, 每2帧执行一次(降低性能影响)
  mov eax, [followTimer]
  inc eax
  and eax, 1
  mov [followTimer], eax
  test eax, eax
  jnz skipFollow

  // 获取玩家基址
  mov eax, [00BDD490]
  test eax, eax
  jz skipFollow

  // 获取怪物池指针
  mov ecx, [00BDD49C]
  test ecx, ecx
  jz skipFollow

  // 获取ZArray第一个槽
  mov ebx, [ecx+28]
  test ebx, ebx
  jz skipFollow

  // 遍历怪物槽
  mov esi, ebx

mobLoop:
  mov edi, [esi+4]          // mobPtr
  test edi, edi
  jz nextSlot

  // 检查怪物ID (明文+0x174, 非0=有效)
  mov edx, [edi+174]
  test edx, edx
  jle nextSlot

  // 读取怪物坐标 (无CRC保护)
  mov ebx, [edi+4C4]        // X坐标
  mov edx, [edi+4C8]        // Y坐标

  // 写入玩家传送字段
  mov [eax+28F8], ebx       // X
  mov [eax+28FC], edx       // Y
  mov dword [eax+28F0], 1   // 移动标志
  mov dword [eax+2900], 0   // 移动进度(触发同步)

  jmp done

nextSlot:
  mov edx, [esi-12]
  test edx, edx
  jz done
  lea esi, [edx+16]
  jmp mobLoop

done:
skipFollow:
  // 恢复寄存器
  pop edi
  pop esi
  pop ebx
  pop edx
  pop ecx
  pop eax

  // 执行原始指令 (trampoline)
  push ebx
  push esi
  mov esi, ecx
  call MapleStory.exe+994C7A

  // 跳回原函数继续执行 (0x9552F9 = cmp [esi+28F0], 0)
  jmp MapleStory.exe+9552F9

followExit:

[DISABLE]
// 恢复原始字节
MapleStory.exe+9552F0:
  push ebx
  push esi
  mov esi, ecx
  call MapleStory.exe+994C7A
  nop
  nop

dealloc(followCode)
dealloc(followTimer)
unregistersymbol(followTimer)
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>382</ID>
      <Description>"怪物跟随(Lua) - 定时器驱动"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>-- 怪物跟随 Lua 脚本
-- 每 100ms 将玩家瞬移到地图上第一个怪物的位置

if not followMonsterTimer then
  followMonsterTimer = createTimer(nil)
  followMonsterTimer.Interval = 100
  followMonsterTimer.OnTimer = function()
    local playerBase = readInteger(0x00BDD490)
    if not playerBase or playerBase &lt; 0x10000 then return end
    
    local poolAddr = readInteger(0x00BDD49C)
    if not poolAddr or poolAddr &lt; 0x10000 then return end
    
    local firstSlot = readInteger(poolAddr + 0x28)
    if not firstSlot or firstSlot &lt; 0x10000 then return end
    
    local slot = firstSlot
    while slot and slot &gt; 0x10000 do
      local mobPtr = readInteger(slot + 4)
      if mobPtr and mobPtr &gt; 0x10000 then
        local mobId = readInteger(mobPtr + 0x174)
        if mobId and mobId &gt; 0 then
          local mobX = readInteger(mobPtr + 0x4C4)
          local mobY = readInteger(mobPtr + 0x4C8)
          
          -- 传送玩家到怪物位置
          writeInteger(playerBase + 0x28F8, mobX)
          writeInteger(playerBase + 0x28FC, mobY)
          writeInteger(playerBase + 0x28F0, 1)
          writeInteger(playerBase + 0x2900, 0)
          return  -- 只跟随第一个怪物
        end
      end
      
      local nextOffset = readInteger(slot - 12)
      if nextOffset and nextOffset ~= 0 then
        slot = nextOffset + 16
      else
        break
      end
    end
  end
  followMonsterTimer.Enabled = false
end

if followMonsterTimer.Enabled then
  followMonsterTimer.Enabled = false
  print("怪物跟随 关闭")
else
  followMonsterTimer.Enabled = true
  print("怪物跟随 开启")
end
</AssemblerScript>
    </CheatEntry>
