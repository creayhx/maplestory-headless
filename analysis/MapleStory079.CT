        <CheatEntry>
          <ID>347</ID>
          <Description>"背包查询-LUA"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat


function dumpInventory(tab)
    local config = {
        ["装备"] = { id = 1, buf = "EquipBuf", name = "装备" },
        ["消耗"] = { id = 2, buf = "ConsumeBuf", name = "消耗" },
        ["设置"] = { id = 3, buf = "SetupBuf", name = "设置" },
        ["其他"] = { id = 4, buf = "EtcBuf", name = "其他" },
        ["现金"] = { id = 5, buf = "CashBuf", name = "现金" },
        [1] = { id = 1, buf = "EquipBuf", name = "装备" },
        [2] = { id = 2, buf = "ConsumeBuf", name = "消耗" },
        [3] = { id = 3, buf = "SetupBuf", name = "设置" },
        [4] = { id = 4, buf = "EtcBuf", name = "其他" },
        [5] = { id = 5, buf = "CashBuf", name = "现金" },
    }

    local info = config[tab]
    if not info then
        print("用法: dumpInventory(\"消耗\") 或 dumpInventory(2)")
        print("可选: 装备/消耗/设置/其他/现金 (对应 tab 1~5)")
        return
    end

    local ok, bufAddr = pcall(getAddress, info.buf)
    if not ok then
        print(string.format("[错误] 符号 '%s' 未注册，请先启用对应的 AA 脚本", info.buf))
        return
    end

    local count = readInteger(bufAddr)
    if not count or count == 0 then
        print(string.format("=== %s背包: 空 (0 items) ===", info.name))
        return
    end

    print(string.format("=== %s背包 (%d items) ===", info.name, count))
    print(string.format("%-4s %-12s %s", "槽位", "物品ID", "数量"))
    print(string.rep("-", 35))

    for i = 1, count do
        local base = bufAddr + 4 + (i - 1) * 8
        local itemId = readInteger(base)
        local qty = readInteger(base + 4)
        if itemId and itemId &gt; 0 then
            print(string.format("%-4d %-12d %d", i, itemId, qty or 0))
        end
    end
    print(string.rep("-", 35))
    print(string.format("总计: %d 个物品", count))
end

function dumpAll()
    local tabs = {"装备", "消耗", "设置", "其他", "现金"}
    for _, name in ipairs(tabs) do
        dumpInventory(name)
        print("")
    end
end

print("=== 背包调试工具已加载 ===")
print("可用命令:")
print("  dumpInventory(\"消耗\")   查看指定背包")
print("  dumpInventory(2)       - 按 tab ID 查看")
print("  dumpAll()              - 查看全部 5 个背包")
print("  输入指定命令后点击执行即可查看背包数据")
dumpAll()


 
 
