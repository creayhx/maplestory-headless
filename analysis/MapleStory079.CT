mov esi,0BE33A9

compare:
cmp eax,#100000
jb exit
cmp [esi],0
je write
cmp [esi],eax
je exit
add esi,4
jmp compare


write:
mov [esi],eax
add [0BE33A5],1

exit:
pop esi
mov [edi+34],eax
jmp returnhere

