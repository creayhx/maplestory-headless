        <CheatEntry>
          <ID>379</ID>
          <Description>"全图攻击+自动循环(无需攻击触发)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
alloc(CoordCave, 2048)
registersymbol(CoordCave)

CoordCave:
  pushad
  mov esi, [00BDD490]
  test esi, esi
  jz CoordExit
  push edx
  push ecx
  push ebx
  mov eax, [00BDEB38]
  test eax, eax
  jz CoordNo
  mov edx, eax
  cmp dword [edx+0C], 0
  je CoordNo
  mov [CoordCave+384], esi
  mov eax, [esi+0ee8]
  mov [CoordCave+380], eax
  mov eax, [esi+0eec]
  mov [CoordCave+390], eax
  mov dword [CoordCave+388], 0
  mov ecx, [CoordCave+3C8]
  test ecx, ecx
  jnz HaveCnt
  mov ecx, [edx+0C]
  test ecx, ecx
  jz CoordNo
  mov [CoordCave+3C8], ecx
HaveCnt:
  mov ebx, [CoordCave+3A0]
  inc ebx
  cmp ebx, ecx
  jb SaveIdx
  xor ebx, ebx
SaveIdx:
  mov [CoordCave+3A0], ebx
  cmp ebx, [edx+0C]
  jae CoordNo
  lea ecx, [edx+18]
  push ebx
  call 00743100
  test eax, eax
  jz CoordNo
  mov eax, [eax+4]
  test eax, eax
  jz CoordNo
  movsx ecx, word [eax+14]
  sub ecx, 20
  movsx edx, word [eax+18]
  mov [esi+0ee8], ecx
  mov [esi+0eec], edx
  mov dword [CoordCave+388], 1
  inc dword [CoordCave+3D0]
CoordNo:
  pop ebx
  pop ecx
  pop edx
CoordExit:
  popad
  mov esi, [00BDD490]
  jmp 00742393

CoordPost:
  pushad
  cmp dword [CoordCave+388], 0
  je CoordSkip
  mov esi, [CoordCave+384]
  test esi, esi
  jz CoordSkip
  mov eax, [CoordCave+380]
  mov [esi+0ee8], eax
  mov eax, [CoordCave+390]
  mov [esi+0eec], eax
CoordSkip:
  cmp byte [CoordCave+3B4], 1
  je AutoLoop
  mov byte [CoordCave+3B4], 1

  mov ebx, 4

ExtraLoop:
  push eax
  push ecx
  push edx
  mov eax, [00BDEB38]
  test eax, eax
  jz ExtraSkip
  cmp dword [eax+0C], 0
  je ExtraSkip
  mov ecx, eax
  push [00BDD490]
  call 00742294
  add esp, 4
ExtraSkip:
  pop edx
  pop ecx
  pop eax
  dec ebx
  jnz ExtraLoop

  mov byte [CoordCave+3B4], 0

  // ====== 自循环开始 ======
AutoLoop:
  // 重置所有reactor的hit_flag和冷却
  pushad
  mov edi, [00BDEB38]
  test edi, edi
  jz LoopDone2
  mov ecx, [edi+0C]
  test ecx, ecx
  jz LoopDone2
  xor ebx, ebx
ResetLoop2:
  cmp ebx, [edi+0C]
  jae LoopDone2
  lea ecx, [edi+18]
  push ebx
  call 00743100
  add esp, 4
  test eax, eax
  jz ResetNext2
  mov eax, [eax+4]
  test eax, eax
  jz ResetNext2
  mov dword [eax+30], 0
  mov dword [eax+28], 0
  mov dword [eax+2C], 0
ResetNext2:
  inc ebx
  jmp ResetLoop2
LoopDone2:
  popad

  // 清除缓存计数和索引
  mov dword [CoordCave+3C8], 0
  mov dword [CoordCave+3A0], 0
  mov dword [CoordCave+38C], 0

  // 延迟~15ms
  call 00994C7A
  add eax, 15
WaitLoop:
  push eax
  call 00994C7A
  pop ecx
  cmp eax, ecx
  jb WaitLoop

  // 跳回TryHitReactor入口
  popad
  jmp 00742294

AllDone:
  popad
  or dword [ebp-4], -1
  lea ecx, [ebp-10]
  jmp 0074269E

0074238D:
  jmp CoordCave
  nop

00742697:
  jmp CoordPost
  nop
  nop

[DISABLE]
0074238D:
  db 8B 35 90 D4 BD 00
00742697:
  db 83 4D FC FF 8D 4D F0
dealloc(CoordCave)
unregistersymbol(CoordCave)
</AssemblerScript>
