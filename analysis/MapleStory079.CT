          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]

// ============================================================
// 背包-装备查询 (装备栏专用)
// ──────────────────────────────────────────────────────────
// 通过 GetItem(0x4296B0) 逐格获取物品 (Tab 1, 96格)
// 通过简单 XOR (低16位 XOR 高16位) 解密数量
// ============================================================

alloc(EquipBuf, 2048)
registersymbol(EquipBuf)

alloc(ScriptCode, 1024)
alloc(TmpResult, 8)

label(HookEntry)
label(SlotLoop)
label(NextSlot)
label(QtyZero)
label(Done)
label(Return)

ScriptCode:
HookEntry:
  pushad
  pushfd

  mov eax, [BD9028]
  test eax, eax
  je Done
  mov eax, [eax+2094]
  test eax, eax
  je Done
  mov ebp, eax

  mov edi, EquipBuf
  xor eax, eax
  mov [edi], eax
  add edi, 4

  xor esi, esi
  xor ebx, ebx

SlotLoop:
  inc esi
  cmp esi, 96
  jg Done

  lea eax, [TmpResult]
  push esi
  push 1
  push eax
  mov ecx, ebp
  call 004296B0

  mov eax, [TmpResult+4]
  test eax, eax
  je NextSlot
  cmp eax, 10000
  jb NextSlot

  push ebx
  push esi
  push eax

  lea ecx, [eax+0C]
  call 00429944
  mov [edi], eax

  pop eax
  mov ecx, [eax+28]
  mov edx, ecx
  and ecx, FFFF
  shr edx, 16
  xor cx, dx

  test cx, cx          // qty &gt; 0?
  je QtyZero

  mov [edi+4], ecx
  add edi, 8

  pop esi
  pop ebx
  inc ebx
  jmp NextSlot

QtyZero:
  add esp, 8            // clean esi, ebx from stack
  jmp NextSlot

NextSlot:
  jmp SlotLoop

Done:
  mov eax, EquipBuf
  mov [eax], ebx

  popfd
  popad

  push ebp
  mov ebp, esp
  push ecx
  mov eax, [ecx+2094]
  jmp Return

00426F51:
  jmp HookEntry
  nop
  nop
  nop
  nop
  nop

Return:

[DISABLE]
00426F51:
  db 55 8B EC 51 8B 81 94 20 00 00

unregistersymbol(EquipBuf)
unregistersymbol(TmpResult)
dealloc(EquipBuf)
dealloc(ScriptCode)
dealloc(TmpResult)
</AssemblerScript>
