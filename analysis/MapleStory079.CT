    <CheatEntry>
      <ID>293</ID>
      <Description>"读取消耗栏第1格物品(含ID+数量)"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
alloc(InventoryReader,2048)
label(ReturnHook)
label(ReadDone)
label(ReadSkipID)

registersymbol(pCharacterData)
registersymbol(pUseArray)
registersymbol(pItemSlot1)
registersymbol(dwItemID)
registersymbol(dwQuantity)
registersymbol(dwRawID1)
registersymbol(dwRawID2)

InventoryReader:
// ---- Data storage ----
pCharacterData:
  dd 0
pUseArray:
  dd 0
pItemSlot1:
  dd 0
dwItemID:
  dd 0
dwQuantity:
  dd 0
dwRawID1:
  dd 0
dwRawID2:
  dd 0

// ---- Hook code (hook CWvsContext::GetCharacterData @ 426F51) ----
HookEntry:
  pushad
  pushfd

  // 读取指针链: CWvsContext -&gt; CharacterData -&gt; UseArray -&gt; Item
  mov eax, [BD9028]
  test eax, eax
  je ReadDone
  mov eax, [eax+2094]
  test eax, eax
  je ReadDone
  mov [pCharacterData], eax

  mov ebx, [eax+2CF]
  test ebx, ebx
  je ReadDone
  mov [pUseArray], ebx

  mov ecx, [ebx+0C]
  mov [pItemSlot1], ecx
  test ecx, ecx
  je ReadDone

  // 读取 TSecType_long_ 原始加密值
  mov edx, [ecx+0C]
  mov [dwRawID1], edx
  mov edx, [ecx+10]
  mov [dwRawID2], edx

  // ---- 调用 TSecType_long_::GetData 获取真实物品ID ----
  // 检查验证缓冲区指针是否有效 (item+0x14)
  mov eax, [ecx+14]
  test eax, eax
  je ReadSkipID
  // 检查验证缓冲区内容是否有效
  mov eax, [eax]
  test eax, eax
  je ReadSkipID

  // 调用 TSecType_long_::GetData(0x429944)
  // ecx = this (TSecType_long_ 指针 = item + 0xC)
  // ebx = 参数 (函数内部会覆盖,初始值不影响)
  lea ecx, [ecx+0C]
  mov ebx, 0
  call 429944
  // eax = 真实物品ID
  mov [dwItemID], eax

ReadSkipID:
  // ---- 读取数量 (ZtlSecureTear_unsigned_short_ 解码) ----
  // item+0x28: 低16位 = 随机key, 高16位 = key XOR 实际数量
  // 数量 = 低16位 XOR 高16位
  mov ecx, [pItemSlot1]
  test ecx, ecx
  je ReadDone
  mov eax, [ecx+28]
  mov edx, eax
  and eax, FFFF           // eax = 低16位 (key)
  shr edx, 10             // edx = 高16位 (encrypted)  注意: 0x10 = 16
  xor ax, dx              // ax = quantity
  and eax, FFFF           // 清除高位
  mov [dwQuantity], eax

ReadDone:
  popfd
  popad

  // 执行被覆盖的原始指令 (10 bytes: push ebp; mov ebp,esp; push ecx; mov eax,[ecx+2094])
  push ebp
  mov ebp, esp
  push ecx
  mov eax, [ecx+2094]
  jmp ReturnHook

// ---- 注入点: 覆盖 GetCharacterData 开头10字节 ----
426F51:
  jmp HookEntry
  nop
  nop
  nop
  nop
  nop

ReturnHook:

[DISABLE]
426F51:
  db 55 8B EC 51 8B 81 94 20 00 00

unregistersymbol(pCharacterData)
unregistersymbol(pUseArray)
unregistersymbol(pItemSlot1)
unregistersymbol(dwItemID)
unregistersymbol(dwQuantity)
unregistersymbol(dwRawID1)
unregistersymbol(dwRawID2)
dealloc(InventoryReader)
</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>294</ID>
          <Description>"CharacterData 指针"</Description>
          <VariableType>4 Bytes</VariableType>
          <Address>pCharacterData</Address>
        </CheatEntry>
        <CheatEntry>
          <ID>295</ID>
          <Description>"消耗背包数组指针"</Description>
          <VariableType>4 Bytes</VariableType>
          <Address>pUseArray</Address>
        </CheatEntry>
        <CheatEntry>
          <ID>296</ID>
          <Description>"第1格物品指针"</Description>
          <VariableType>4 Bytes</VariableType>
          <Address>pItemSlot1</Address>
        </CheatEntry>
        <CheatEntry>
          <ID>297</ID>
          <Description>"真实物品ID (解码后)"</Description>
          <VariableType>4 Bytes</VariableType>
          <Address>dwItemID</Address>
        </CheatEntry>
        <CheatEntry>
          <ID>298</ID>
          <Description>"物品数量"</Description>
          <VariableType>4 Bytes</VariableType>
          <Address>dwQuantity</Address>
        </CheatEntry>
        <CheatEntry>
          <ID>299</ID>
          <Description>"物品ID加密值1 (item+0C)"</Description>
          <VariableType>4 Bytes</VariableType>
          <Address>dwRawID1</Address>
        </CheatEntry>
        <CheatEntry>
          <ID>300</ID>
          <Description>"物品ID加密值2 (item+10)"</Description>
          <VariableType>4 Bytes</VariableType>
          <Address>dwRawID2</Address>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
    <CheatEntry>
      <ID>304</ID>
      <Description>"全图捡物"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
// sub_50D440 - 距离检测跳转改为无条件跳转
// 原: test eax,eax; jnz 50D5E3 (85 C0 75 26)
// 改: jmp 50D5E3; nop; nop      (EB 28 90 90)
50D5B9:
  db EB 28 90 90

[DISABLE]
50D5B9:
  db 85 C0 75 26
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>374</ID>
      <Description>"捡取时同步物品坐标到人物坐标"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]

// ===== 捡取时同步物品坐标到人物坐标 =====
// 全屏捡取后，服务端发包中仍是玩家原始坐标，可能被服务端距离检测拒绝。
// 方案：在捡取路径入口 0x50D5E3 hook，解码物品坐标后写入人物坐标，再走原发包路径。
// 此时 esi = drop+0x68（物品 TSecType_long 结构体基址），[0xBDD490] = 人物基址

alloc(PickupPosSync, 512)
label(PickupPosSync_Return)

PickupPosSync:
  pushad
  pushfd

  // esi = drop+0x68 (TSecType_long 结构体基址，此时仍有效)
  // 物品 X 的 TSecType_long 在 esi+0x00
  lea ecx, [esi]
  call 00429944                 // TSecType_long::GetData → eax = X
  mov ebx, eax                  // ebx = X

  // 物品 Y 的 TSecType_long 在 esi+0x0C
  lea ecx, [esi+0C]
  call 00429944                 // TSecType_long::GetData → eax = Y
  mov edx, eax                  // edx = Y

  // 加载人物基址
  mov eax, [00BDD490]
  test eax, eax
  jz PickupPosSync_Skip

  // 写入记录坐标（服务端校验用）
  mov [eax+0EE8], ebx           // record X
  mov [eax+0EEC], edx           // record Y
  mov [eax+0EF0], ebx           // copy2 X
  mov [eax+0EF4], edx           // copy2 Y

  // 写入真实坐标 + 移动标志
  // mov [eax+28F8], ebx           // real X
  // mov [eax+28FC], edx           // real Y
  // mov dword ptr [eax+28F0], 1   // move flag = 1（触发坐标同步）

PickupPosSync_Skip:
  popfd
  popad
  // 原 0x50D5E3 处 6 字节指令
  db 8B 4D E8 39 59 30         // mov ecx,[ebp-18]; cmp [ecx+30],ebx
  jmp PickupPosSync_Return

// Hook: 替换 0x50D5E3~0x50D5E8 为 jmp + nop（共 6 字节）
0050D5E3:
  jmp PickupPosSync
  nop
PickupPosSync_Return:

[DISABLE]
0050D5E3:
  db 8B 4D E8 39 59 30
  dealloc(PickupPosSync)
</AssemblerScript>
    </CheatEntry>
