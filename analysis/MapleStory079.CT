    <CheatEntry>
      <ID>330</ID>
      <Description>"BUFF-属性"</Description>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>325</ID>
          <Description>"BUFF物防-修改值生成"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
// ============================================
// Hook: 替换物防明文值, 生成任意数值的加密BUFF数据
// 原理: 在 ZtlSecureTear_long_ 加密前修改 ECX(明文值)
// 用法:
//   1. 启用本脚本
//   2. 使用一个物防BUFF技能
//   3. 读取 0xBE4FDC 的24字节并保存
//   4. 禁用本脚本
// ============================================

alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
  mov ecx,#99999999          // ← 在此修改目标防御值
  // 原代码: movsx ecx,ax    // 已替换
  lea edx,[esi+3C]            // 原代码: 物防缓冲区
  jmp returnhere

originalcode:
  movsx ecx,ax
  lea edx,[esi+3C]

exit:
  jmp returnhere

789E50:
  jmp newmem
  nop
returnhere:

[DISABLE]
789E50:
  db 0F BF C8 8D 56 3C
</AssemblerScript>
        </CheatEntry>
