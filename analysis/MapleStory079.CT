        <CheatEntry>
          <ID>378</ID>
          <Description>"重置Reactor+定时触发(仅分配函数,无Hook)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
alloc(ReactorTimer, 1024)
label(ResetReactors)
label(CallTryHit)

ReactorTimer:
dd 0, 0, 0, 0

ResetReactors:
  pushad
  mov edi, [00BDEB38]
  test edi, edi
  jz ResetDone
  
  mov ecx, [edi+0C]
  test ecx, ecx
  jz ResetDone
  mov [ReactorTimer], ecx
  
  xor ebx, ebx
ResetLoop:
  cmp ebx, [edi+0C]
  jae ResetDone
  
  lea ecx, [edi+18]
  push ebx
  call 00743100
  add esp, 4
  test eax, eax
  jz ResetNext
  
  mov eax, [eax+4]
  test eax, eax
  jz ResetNext
  
  mov dword [eax+30], 0
  mov dword [eax+28], 0
  mov dword [eax+2C], 0
  
ResetNext:
  inc ebx
  jmp ResetLoop

ResetDone:
  popad
  ret

CallTryHit:
  push [00BDD490]
  mov ecx, [00BDEB38]
  call 00742294
  ret

registersymbol(ReactorTimer)
registersymbol(ResetReactors)
registersymbol(CallTryHit)

[DISABLE]
unregistersymbol(ReactorTimer)
unregistersymbol(ResetReactors)
unregistersymbol(CallTryHit)
dealloc(ReactorTimer)
</AssemblerScript>
