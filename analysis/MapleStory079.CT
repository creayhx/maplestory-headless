      <ID>284</ID>
      <Description>"物品掉落人物位置 (Drop to Player)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
alloc(DropToPlayer,2048)

DropToPlayer:
  // 读取人物X坐标: [[MapleStory.exe+7DD490]+0xEE8]
  mov eax,[00BDD490]
  mov eax,[eax+00000EE8]
  mov [ebp-88],eax
  // 读取人物Y坐标: [[MapleStory.exe+7DD490]+0xEEC]
  mov eax,[00BDD490]
  mov eax,[eax+00000EEC]
  mov [ebp-84],eax
  // 执行原始指令
  mov eax,[ebp-14]
  lea ecx,[ebp-88]
  push ecx
  jmp 0050e878

0050e86e:
  jmp DropToPlayer
  db 90 90 90 90 90

[DISABLE]
0050e86e:
  db 8B 45 EC
  db 8D 8D 78 FF FF FF
  db 51

dealloc(DropToPlayer)
</AssemblerScript>
